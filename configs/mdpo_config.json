{
    "model_id": "./models/Dolphin3.0-Llama3.1-8B",
    "train_file": "./data/iter1_dpo_pairs.jsonl",
    "output_dir": "./outputs/generator",
    "output_model_name": "generator-iter2-mdpo",
    "dtype": "bfloat16",
    "learning_rate": 2e-07,
    "beta": 0.1,
    "gamma": 0.9,
    "K": 12,
    "use_lora": true,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "lora_target_modules": "all-linear",
    "lora_bias": "none",
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 4,
    "num_train_epochs": 1,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.1,
    "max_prompt_length": 512,
    "max_length": 600,
    "optim": "adamw_torch",
    "fp16": false,
    "bf16": true,
    "tf32": true,
    "logging_steps": 100,
    "save_steps": 5000,
    "eval_strategy": "no",
    "report_to": "none",
    "seed": 42
}
