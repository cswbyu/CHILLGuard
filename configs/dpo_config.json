{
    "dpo_lora": {
        "model_id": "./models/Dolphin3.0-Llama3.1-8B",
        "train_file": "./data/iter2_pairs/iter2_dpo_pairs.jsonl",
        "output_dir": "./outputs/generator_dpo",
        "output_model_name": "generator-iter2-dpo",
        "dtype": "bfloat16",
        "learning_rate": 2e-07,
        "beta": 0.1,
        "per_device_train_batch_size": 16,
        "gradient_accumulation_steps": 1,
        "num_train_epochs": 1,
        "lr_scheduler_type": "cosine",
        "warmup_ratio": 0.1,
        "max_length": 600,
        "optim": "adamw_torch",
        "fp16": false,
        "bf16": true,
        "tf32": true,
        "logging_steps": 100,
        "save_steps": 5000,
        "report_to": "none",
        "lora_r": 16,
        "lora_alpha": 32,
        "lora_dropout": 0.05
    }
}